# ── Bot ──────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=

# ── Orchestrator ─────────────────────────────────────────────────────
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Speech ───────────────────────────────────────────────────────────
# Provider used by speech-api: speechkit | whisper
SPEECH_PROVIDER=whisper
# Default language for STT/TTS
SPEECH_DEFAULT_LANG=ru-RU

# speechkit provider proxies to the existing speech-service
# (https://github.com/nunmer/speechkit). Point this at a running instance.
SPEECHKIT_URL=http://host.docker.internal:8000
SPEECHKIT_ENGINE=yandex
SPEECHKIT_TTS_VOICE=jane

# whisper provider (local faster-whisper). Smaller = faster, larger = better.
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── Service URLs (used by bot / orchestrator) ────────────────────────
ORCHESTRATOR_URL=http://orchestrator:8000
SPEECH_API_URL=http://speech-api:8002

# ── DB ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://forte:forte@postgres:5432/forte

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MIB ──────────────────────────────────────────────────────────────
MIB_API_BASE=http://mock-mib:8001
MIB_API_TOKEN=mock-token
