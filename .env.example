# ── Bot ──────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=

# ── LLM (OpenAI-compatible) ──────────────────────────────────────────
# Current: OpenAI directly.
# To switch to a self-hosted LiteLLM proxy, set OPENAI_API_BASE to the proxy
# URL (e.g. http://litellm:4000/v1) and OPENAI_MODEL to the model alias
# configured in LiteLLM.  OPENAI_API_KEY must match whatever the proxy expects.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Speech ───────────────────────────────────────────────────────────
# URL of the ForteBank speech-service (port 8000).
# Inside Docker Compose the service is on the host → host.docker.internal.
# In production replace with the real service URL.
SPEECH_SERVICE_URL=http://host.docker.internal:8000

# Engine passed to the speech-service (yandex | whisper | …).
SPEECH_ENGINE=yandex

# Default language when none is supplied by the caller.
# Supported: kk-KZ | ru-RU | en-US
SPEECH_DEFAULT_LANG=ru-RU

# TTS voice names per language (Yandex SpeechKit voice IDs). The voice selects
# the spoken language, so Kazakh needs a Kazakh voice (madi/amira/saule/zhanar);
# jane is Russian. No dedicated English voice exists → Russian fallback.
TTS_VOICE_RU=jane
TTS_VOICE_KK=madi
TTS_VOICE_EN=jane
TTS_VOICE_DEFAULT=jane

# ── Service URLs (used by bot / orchestrator) ────────────────────────
ORCHESTRATOR_URL=http://orchestrator:8000

# When true, replies to a voice note are sent as BOTH a TTS voice note and
# text. When false (or if synthesis fails), replies are text only.
TTS_VOICE_REPLIES=false

# ── DB ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://forte:forte@postgres:5432/forte

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MIB ──────────────────────────────────────────────────────────────
MIB_API_BASE=http://mock-mib:8001
MIB_API_TOKEN=mock-token

# Speech-service API key (X-API-Key header); leave empty if auth disabled
SPEECH_API_KEY=
