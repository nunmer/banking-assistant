# AI MIB Voice Assistant — speech-service / worker
# Real values are injected by DevOps from Vault; this file documents the
# keys each service reads and is safe to commit (no live secrets).
# See ../docs/VAULT_SECRETS.md for the full inventory + Vault path mapping.

# App
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=*

# Engine selection — both self-hosted, no Yandex in the default path.
# STT: GigaAM (see GIGAAM_* below). TTS: Qwen3-TTS (see QWEN_* below).
DEFAULT_STT_ENGINE=gigaam
DEFAULT_TTS_ENGINE=qwen

# Database — VM-hosted Postgres, database "speech" (dedicated to this app;
# orchestrator/web use database "forte" on the same instance — see
# ../.env.example). No Postgres container in this repo.
# REQUIRED — no default, speech-service refuses to start without it.
DATABASE_URL=postgresql+psycopg2://speech:CHANGEME@<vm-postgres-host>:5432/speech

# Celery / Redis — shared Redis container (this repo's docker-compose.yml).
# DB indexes 3/4/5 are reserved for this app; orchestrator/web use DB index 0
# on the same instance — see ../.env.example.
CELERY_BROKER_URL=redis://redis:6379/3
CELERY_RESULT_BACKEND=redis://redis:6379/4
REDIS_URL=redis://redis:6379/5
CELERY_QUEUE=speech_queue

# File storage (shared volume between API and worker)
UPLOAD_DIR=/app/uploads

# Authentication
API_KEY_ENABLED=false
API_KEY_HEADER=X-API-Key

# Rate limiting (per API key, fixed window)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Deduplication
DEDUP_ENABLED=true
TTS_CACHE_TTL_SECONDS=86400

# Note: Yandex SpeechKit vars (YANDEX_*) are intentionally not listed here —
# neither default engine uses them. They're only needed if you explicitly
# request `engine=yandex` on /stt or /tts, or re-enable the hands-free
# streaming voice feature (STREAMING_VOICE_ENABLED), which has no GigaAM/Qwen
# streaming equivalent and is Yandex-only. Add them back if either applies.

# GigaAM (self-hosted, OpenAI-compatible /v1/audio/transcriptions)
GIGAAM_STT_URL=http://10.0.94.187:8003/v1/audio/transcriptions
GIGAAM_MODEL=gigaam-multilingual-large-ctc
GIGAAM_TIMEOUT=120

# Qwen3-TTS (self-hosted, OpenAI-compatible /v1/audio/speech)
QWEN_TTS_URL=http://10.0.94.187:8002/v1/audio/speech
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN_TIMEOUT=120
