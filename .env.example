# AI MIB Voice Assistant — orchestrator / web / mib-service
# Real values are injected by DevOps from Vault; this file documents the
# keys each service reads and is safe to commit (no live secrets).
# See docs/VAULT_SECRETS.md for the full inventory + Vault path mapping.

# ── LLM (OpenAI-compatible) ──────────────────────────────────────────
# Current: OpenAI directly.
# To switch to a self-hosted LiteLLM proxy, set OPENAI_API_BASE to the proxy
# URL (e.g. http://litellm:4000/v1) and OPENAI_MODEL to the model alias
# configured in LiteLLM.  OPENAI_API_KEY must match whatever the proxy expects.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Speech ───────────────────────────────────────────────────────────
# URL of the speech-service container.
SPEECH_SERVICE_URL=http://speech-service:8000

# Default language when none is supplied by the caller.
# Supported: kk-KZ | ru-RU | en-US
SPEECH_DEFAULT_LANG=ru-RU

# TTS voice names per language (Yandex SpeechKit voice IDs). The voice selects
# the spoken language, so Kazakh needs a Kazakh voice (amira/madi/saule/zhanar);
# marina is Russian.
TTS_VOICE_RU=marina
TTS_VOICE_KK=amira
TTS_VOICE_DEFAULT=marina

# ── Service URLs (used by web) ────────────────────────────────────────
ORCHESTRATOR_URL=http://orchestrator:8000

# When true, replies to a voice note are sent as BOTH a TTS voice note and
# text. When false (or if synthesis fails), replies are text only.
TTS_VOICE_REPLIES=false

# ── DB ───────────────────────────────────────────────────────────────
# Points at the VM-hosted Postgres (no Postgres container in this repo).
# Database name "forte" is dedicated to this app; speech-service uses its
# own database "speech" on the same instance — see speech-service/.env.example.
# REQUIRED — no default, orchestrator refuses to start without it.
DATABASE_URL=postgresql+asyncpg://forte:CHANGEME@<vm-postgres-host>:5432/forte

# ── Redis ────────────────────────────────────────────────────────────
# Shared Redis container (this repo's docker-compose.yml). DB index 0 is
# reserved for this app; speech-service uses DB indexes 3/4/5 on the same
# instance — see speech-service/.env.example.
REDIS_URL=redis://redis:6379/0

# ── MIB ──────────────────────────────────────────────────────────────
MIB_API_BASE=http://mib-service:8001
MIB_API_TOKEN=mock-token

# ── MIB WebView auth (web/app.py's /mib/auth, web/static/mib-auth.js) ────
# Issued by the MIB/Auth team for this specific webview client — not values
# to invent locally. MIB_AUTH_URL is the Auth service's oauth/ base
# (trailing slash), e.g. https://qa-apigw.fortebank.com/authn.AuthnService/v1/
MIB_AUTH_URL=
MIB_AUTH_CLIENT_ID=
MIB_AUTH_CLIENT_SECRET=
MIB_AUTH_REDIRECT_URI=

# Speech-service API key (X-API-Key header); leave empty if auth disabled
SPEECH_API_KEY=

# Hands-free streaming voice (live WebSocket /ws/converse, gRPC to Yandex).
# Buggy in production as of 2026-07 — default off, client uses the older
# tap-to-stop / one-shot-recording flow (HTTP to speech-service's batch
# /stt/recognize) instead. Set to true to re-enable once stable; no rebuild
# needed, just restart the web service.
STREAMING_VOICE_ENABLED=false

# ── Admin panel (/admin) ───────────────────────────────────────────────
# Basic Auth gating bot configuration, logs, and conversation transcripts.
# Shared by both `web` (the panel itself) and `orchestrator` (its own
# independent auth check on the conversations/scenarios API — defense in
# depth). REQUIRED — no default; both services refuse to start without them.
ADMIN_USER=
ADMIN_PASSWORD=
